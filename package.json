{
  "name": "dogist-comment-intelligence",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "collector:process": "node pipeline/dogist-process.mjs",
    "dogist:analyze": "node pipeline/dogist-opportunity-analyze.mjs",
    "dogist:claude": "node --env-file=.env.local pipeline/dogist-claude-interpret.mjs",
    "dogist:cultural": "node --env-file=.env.local pipeline/dogist-cultural-interpret.mjs",
    "dogist:discover": "python3 pipeline/dogist-cultural-discovery.py",
    "dogist:diet": "node --env-file=.env.local pipeline/dogist-diet-analysis.mjs",
    "dogist:event": "node pipeline/dogist-event-resonance.mjs",
    "dogist:pain-points": "node --env-file=.env.local pipeline/dogist-pain-point-angles.mjs",
    "dogist:angle-messages": "node --env-file=.env.local pipeline/dogist-angle-messages.mjs",
    "dogist:full": "npm run dogist:analyze && npm run dogist:event && npm run dogist:discover && npm run dogist:claude && npm run dogist:diet && npm run dogist:cultural && npm run dogist:pain-points && npm run dogist:angle-messages",
    "dogist:preclaude": "npm run dogist:analyze && npm run dogist:event && npm run dogist:discover",
    "test": "npm run test:unit",
    "test:unit": "node --test tests/dogist-collector-state.test.mjs",
    "test:corpus": "node --test tests/dogist-event-resonance.test.mjs tests/dogist-cultural-discovery.test.mjs"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.78.0",
    "next": "16.2.11",
    "react": "19.2.3",
    "react-dom": "19.2.3"
  },
  "devDependencies": {
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.2.11",
    "typescript": "^5"
  },
  "overrides": {
    "postcss": "^8.5.23",
    "sharp": "^0.35.3",
    "minimatch": "^10.2.5"
  }
}
